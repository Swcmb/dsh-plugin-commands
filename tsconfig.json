{
  "compilerOptions": {
    "module": "preserve",
    "declaration": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022"],
    "types": ["bun", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
